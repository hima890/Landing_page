# ADMIN_EMAIL: Email address for the admin login.
ADMIN_EMAIL="admin@example.com"

# ADMIN_PASSWORD: Password for the admin login. Use a strong, unique password.
ADMIN_PASSWORD="change_me_to_a_strong_password"

# ADMIN_SECRET: Secret key used to sign admin session tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="change_me_to_a_random_secret_string"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEBHOOK_URL: URL for the Google Sheets Apps Script webhook.
VITE_GOOGLE_SHEETS_WEBHOOK_URL=""
